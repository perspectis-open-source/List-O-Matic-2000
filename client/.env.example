# API base (empty means same-origin proxy via Vite dev server)
VITE_API_URL=

# Runtime platform mode
# integrated = governance-backed behavior when server supports it
# standalone = standalone-safe UX (operational logs + basic JSON export)
VITE_PLATFORM_MODE=standalone

# Optional shared secret for export route, if server enforces it
# VITE_REGULATOR_EXPORT_SECRET=
