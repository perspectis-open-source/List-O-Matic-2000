# LLM API key (required)
OPENAI_API_KEY=sk-your-key-here

# Frontend origin for CORS (e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Server port (default 3001)
PORT=3001

# Matcher keybook (optional): directory for company-key.jsonl, contact-company-key.jsonl, contact-company-match.jsonl
# MATCHER_KEYBOOK_DIR=/absolute/or/relative/path/to/matcher-keybook

# Agent (optional): max tool-use rounds per request (default 3)
# MAX_AGENT_ITERATIONS=3

# Optional: real web search API key (if not set, mock search is used)
# TAVILY_API_KEY=your-tavily-key

# LLM evidence JSONL (optional): writable directory; creates list-o-matic-evidence.jsonl (wired via @syncsphere/vendor-governance/node createLlmEvidenceRuntimeFromProcessEnv)
# EVIDENCE_LOG_DIR=/absolute/or/relative/path/to/evidence-logs

# Optional caps when evidence is enabled (read by vendor-governance; omit = defaults 80000 / 80 / 200000)
# EVIDENCE_MAX_MESSAGE_CONTENT_CHARS=500000
# EVIDENCE_MAX_MESSAGES_KEPT=120
# EVIDENCE_MAX_SERIALIZED_JSON_CHARS=500000

# CRM Export (optional -- set both to enable CRM connector)
# CRM_BASE_URL=https://api.yourcrm.com/v1
# CRM_API_KEY=your_crm_api_key
# CRM_AUTH_HEADER=Authorization
# CRM_UPSERT_ENDPOINT=/contacts
